# HA connection
VITE_HA_URL=http://localhost:8123

# Long-lived access token from HA profile (http://localhost:8123/profile > Long-Lived Access Tokens)
# SECURITY: Vite bundles this value into the client-side JS — anyone who can
# load the app can read the token from the source. Mitigations:
#   - Keep the app behind your home network / VPN, never expose it publicly.
#   - Create a dedicated HA user with only the permissions this dashboard needs.
#   - Rotate the token if the device is lost or the app is ever exposed.
VITE_HA_TOKEN=

# Simulator health/metrics server — used by the Backtest tab (POST /backtest).
# Same host as the simulator, port 8088 (HEALTH_PORT). Needs CORS, which the
# health server already sends.
VITE_SIM_URL=http://localhost:8088

# Token for the simulator's guarded endpoints — must match HEALTH_TOKEN in the
# repo-root .env. Without it the Advisor, Event log, Backtest, floor-plan sync,
# web push and the LLM assistant get 401 whenever the dashboard is not served
# from localhost. Same caveat as VITE_HA_TOKEN above: Vite bundles it into the
# client JS. Leave empty for local dev, where the simulator accepts localhost
# requests without a token.
VITE_SIM_TOKEN=

# Location — must match ems_simulator/config.py LAT/LON (Warsaw defaults)
VITE_LAT=52.23
VITE_LON=21.01
