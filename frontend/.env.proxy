# Build mode for serving behind the nginx reverse proxy (npm run build:proxy).
# Makes the app same-origin: Home Assistant under /ha, the simulator under /sim,
# with the origin resolved at runtime — so one build works on localhost, a LAN
# IP, or a Tailscale hostname. Put VITE_HA_TOKEN in .env (loaded in every mode).
VITE_PROXY=1
# Blank out any explicit dev URLs from .env so the same-origin /ha and /sim
# paths take effect (empty = falsy → base.ts uses the proxy paths).
VITE_HA_URL=
VITE_SIM_URL=
