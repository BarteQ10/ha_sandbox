# Copy this file to secrets.yaml (gitignored) and fill in real values.
# Home Assistant resolves every `!secret <key>` in configuration.yaml from here,
# so keep private/identifying values (hostnames, tokens) out of the public repo.

# Public origin allowed to call Home Assistant's HTTP/WebSocket API (the
# dashboard, over Tailscale). Use your real tailnet hostname.
# Referenced by: configuration.yaml → http.cors_allowed_origins
dashboard_cors_origin: "https://your-host.your-tailnet.ts.net"

# Where Home Assistant reaches the simulator. Pick whichever matches how you run
# it — all three name the same process:
#   ems-simulator         HA and the simulator both in docker compose  <- default
#   host.docker.internal  HA in docker, `python run.py` on the host. On Linux add
#                         extra_hosts: ["host.docker.internal:host-gateway"] to
#                         the homeassistant service for this to resolve.
#   192.168.x.y           HA elsewhere on the LAN (a hostname works too)
# Referenced by: configuration.yaml → modbus[0].host
ems_sim_host: "ems-simulator"

# Same host, used by the /metrics REST sensor. A full URL, because YAML cannot
# splice a !secret into a string — keep its host equal to ems_sim_host.
# Referenced by: configuration.yaml → sensor "EMS: Metrics snapshot" (resource)
ems_metrics_url: "http://ems-simulator:8088/metrics"

# Shared token for the simulator's HTTP API (:8088). Must be byte-identical to
# HEALTH_TOKEN in the repo-root .env; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Referenced by: configuration.yaml → sensor "EMS: Metrics snapshot" (headers)
ems_sim_token: "same-value-as-HEALTH_TOKEN-in-dot-env"
