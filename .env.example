# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Docker Compose auto-loads .env for ${VAR} interpolation in docker-compose.yml.

# InfluxDB connection
# SECURITY: the values below are dev defaults and are PUBLIC in the repo. Before
# exposing InfluxDB beyond localhost (LAN, tailnet, port-forward), set a strong
# password and a fresh random admin token here — docker-compose reads them from
# .env, and the simulator authenticates with INFLUX_TOKEN.
INFLUX_URL=http://localhost:8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=admin123
INFLUX_TOKEN=ems-token
INFLUX_ORG=home
INFLUX_BUCKET=ems

# Simulator HTTP API auth (health server on HEALTH_PORT). Required by every
# endpoint except /health and /push/key: the writes (/assistant, POST /floorplan,
# /push/*, /test-alarm), /backtest, and the reads that give away whether anyone
# is home (/metrics, /events, /advisor). Left empty they answer localhost only,
# so a proxied dashboard and HA's REST sensor both get 401. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# THREE files need the same value: this one, frontend/.env (VITE_SIM_TOKEN) and
# config/secrets.yaml (ems_sim_token, used by HA's /metrics sensor).
HEALTH_TOKEN=

# Which groups of SIMULATED devices to publish to Home Assistant. Empty = all.
#   energy  PV, SoC, load, price, balance, standby, MPC action, V2G switch
#   house   house temp, presence, media, circadian light, living-room TRV
#   security  motion x2, window, door, leak, smoke, CO, doorbell, lock
#   air     humidity, CO2, PM2.5, VOC, air-quality alert
#   meters  water, gas
#   appliances  gate, garage, irrigation, fan, vacuum
# An entry is a group, a single device id, or either prefixed with "-" to drop
# it. Removals apply last, and a list of only removals starts from everything,
# so a migration is one token per device as the real hardware lands:
#   (empty)                            every simulated device
#   -window_living,-door_entrance      all but those two (real Zigbee contacts)
#   security,-smoke,-co                only security, minus the real detectors
#   energy,trv_living                  one group plus one single device
#   none                               retire the lot
# Whatever is off is actively removed from HA on the next start, not left as an
# unavailable ghost.
EMS_SIM_DEVICES=

# Telegram alerts (token from @BotFather, chat id from @userinfobot)
EMS_TELEGRAM_TOKEN=
EMS_TELEGRAM_CHAT_ID=

# Generic webhook for alerts (POST JSON {"text","severity"}); leave empty to disable
EMS_WEBHOOK_URL=

# Local LLM for the natural-language assistant (LM Studio / Ollama). Empty = the
# assistant uses its offline rule parser only.
EMS_LLM_URL=
EMS_LLM_MODEL=bielik-11b-v3.0-instruct

# Web Push (VAPID). Generate: python -m ems_simulator.push --gen-keys
EMS_VAPID_PUBLIC=
EMS_VAPID_PRIVATE=
EMS_VAPID_SUBJECT=mailto:admin@example.com

# Tailscale-in-a-container (docker compose --profile tailscale up). Reusable auth
# key from the Tailscale admin console. Linux/Pi only; on Windows use host install.
TS_AUTHKEY=
