# Bytecode and compiled files
*.pyc
__pycache__/

# Node (stray root-level installs / tool caches)
node_modules/
.vite/

# Home Assistant - generated/runtime files (not source code)
config/.cache/
config/.cloud/
config/.storage/
config/deps/
config/tts/
config/home-assistant_v2.db*
config/.HA_VERSION
config/.ha_run.lock

# Logs
*.log
*.log.*

# Environment variables or secrets
.env
config/secrets.yaml

# Docker runtime data (auto-created by containers)
influxdb/
grafana/
mosquitto/data/
mosquitto/log/

# Zigbee2MQTT runtime data — contains the Zigbee network key + paired-device DB.
# Keep only configuration.example.yaml in git.
zigbee2mqtt/data/

# RL agent Q-table (trained model — large binary)
rl/qtable.npy

# Generated ML forecast plots
forecast.png
forecast_feature_importance.png

# Simulator runtime data (floor-plan layout)
simulator_data/

# Tailscale container node state (keys) — keep serve.json, ignore state
tailscale/state/
